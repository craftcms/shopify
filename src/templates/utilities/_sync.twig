<h2>{{ "Shopify Sync"|t('shopify') }}</h2>
{% import "_includes/forms" as forms %}

{% if canCreateSync %}
  <form method="POST">
      {{ actionInput('') }}
      {{ csrfInput() }}

      <a class="btn submit formsubmit" data-icon="refresh"
         data-action="shopify/products/sync"
         data-confirm="{{ 'Are you sure you want to run a complete sync of all products?'|t('shopify') }}">
          {{ 'Sync all Products'|t('shopify') }}
      </a>
  </form>
  <hr>
{% endif %}

{% if tableData|length %}
<div id="shopify-bulk-ops"></div>

{% js %}
var columns = [
  { name: 'objects', title: Craft.t('shopify', 'Objects') },
  { name: 'status', title: Craft.t('shopify', 'Status') },
  { name: 'shopifyStatus', title: Craft.t('shopify', 'Shopify Status') },
  { name: 'dateCreated', title: Craft.t('shopify', 'Date Created') },
  { name: 'dateUpdated', title: Craft.t('shopify', 'Date Updated') },
];

new Craft.VueAdminTable({
    columns: columns,
    container: '#shopify-bulk-ops',
    tableData: {{ tableData|json_encode|raw }},
    deleteAction: 'shopify/sync/delete',
    deleteConfirmationMessage: Craft.t('shopify', "Are you sure you want to delete this sync?"),
    deleteFailMessage: Craft.t('shopify', "Sync could not be deleted"),
    deleteSuccessMessage: Craft.t('shopify', "Sync deleted"),
    padded: true,
});
{% endjs %}
{% endif %}