includes:
    - phpstan-baseline.neon

parameters:
    phpVersion: 80500
    level: 5
    paths:
        - src
        - src-yii2
        - database
        - routes
    excludePaths:
        - src-yii2/feedme
    scanFiles:
        - vendor/craftcms/yii2-adapter/legacy/Craft.php
        - vendor/craftcms/yii2-adapter/lib/yii2/Yii.php
        - vendor/twig/twig/src/Extension/CoreExtension.php
    earlyTerminatingMethodCalls:
        Craft:
            - dd
        yii\base\Application:
            - end
